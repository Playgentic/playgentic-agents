{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "playgentic",
  "version": "0.2.0",
  "description": "Agent pipeline for authoring and repairing Playwright tests (plain or playwright-bdd) in any repo",
  "author": {
    "name": "Blaise Moses"
  },
  "homepage": "https://github.com/playgentic/playgentic-agents",
  "repository": "https://github.com/playgentic/playgentic-agents",
  "license": "MIT",
  "keywords": [
    "playwright",
    "playwright-bdd",
    "testing",
    "test-automation",
    "bdd",
    "agents"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "playgentic",
        "category": "Coding"
      }
    }
  }
}
